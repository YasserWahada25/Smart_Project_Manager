# ==================================================
# Smart Project Manager - AI service environment template
# ==================================================
# Copy to `ai-service/.env` and adjust. NEVER commit `.env`.

# Shared secret between the Express backend and this service (required, at least 32 characters).
# The same value must be set as AI_SERVICE_TOKEN in backend/.env.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
AI_SERVICE_TOKEN=

# LLM (optional): any OpenAI-compatible Chat Completions API. Without a key, the local analyzer is used
# instead of the LLM (AI-01) and the assistant (AI-04) is unavailable. The provider is detected from the URL.
#   OpenAI:        OPENAI_BASE_URL=https://api.openai.com/v1                                OPENAI_MODEL=gpt-4o-mini
#   Google Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ OPENAI_MODEL=gemini-3.5-flash-lite
#                  (free key: https://aistudio.google.com/apikey; the "lite" models have a larger free quota)
#   Groq:          OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:        OPENAI_BASE_URL=http://localhost:11434/v1 (any non-empty key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
# Longer documents are truncated before being sent to the LLM.
LLM_MAX_DOCUMENT_CHARS=30000

# Uploaded specification documents
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARS=100000

LOG_LEVEL=INFO
