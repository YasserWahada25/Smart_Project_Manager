# ==================================================
# Smart Project Manager - AI service environment template
# ==================================================
# Copy to `ai-service/.env` and adjust. NEVER commit `.env`.

# Shared secret between the Express backend and this service (required, at least 32 characters).
# The same value must be set as AI_SERVICE_TOKEN in backend/.env.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
AI_SERVICE_TOKEN=

# OpenAI (optional). Without a key, the local analyzer is used instead of the LLM.
OPENAI_API_KEY=
# Any chat model of your account that supports Structured Outputs.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
# Longer documents are truncated before being sent to the LLM.
LLM_MAX_DOCUMENT_CHARS=30000

# Uploaded specification documents
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARS=100000

LOG_LEVEL=INFO
