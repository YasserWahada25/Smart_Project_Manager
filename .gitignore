# ==================================================
# Smart Project Manager - Git ignore rules
# ==================================================

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Node.js (backend + frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ---------- Angular ----------
dist/
.angular/
out-tsc/

# ---------- Python (AI service) ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
# Generated ML model: retrained automatically from app/ml/data (python -m app.ml.task_type_model)
ai-service/app/ml/models/

# ---------- Tests / coverage ----------
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*

# ---------- Logs ----------
logs/
*.log

# ---------- IDE / editors ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
