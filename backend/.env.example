# ==================================================
# Smart Project Manager - backend environment template
# ==================================================
# Copy to `backend/.env` and adjust. NEVER commit `.env`.

# development | production | test
NODE_ENV=development

# HTTP port of the Express API
PORT=3000

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/smart_project_manager

# Allowed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:4200

# Secret used to sign JWTs (required, at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token lifetime: seconds or a duration such as 1h, 1d, 7d
JWT_EXPIRES_IN=1d

# bcrypt cost factor (4-15). Higher = slower hashing = harder to brute-force.
BCRYPT_SALT_ROUNDS=12

# Initial administrator, created with: npm run create-admin
# Only read by that command. Remove ADMIN_PASSWORD once the account exists.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator

# AI service (FastAPI). Without AI_SERVICE_TOKEN the AI features report "not configured".
AI_SERVICE_URL=http://localhost:8000
# Same value as AI_SERVICE_TOKEN in ai-service/.env (at least 32 characters).
AI_SERVICE_TOKEN=
# Timeout of the AI requests in milliseconds (1000-300000); an LLM analysis can take a minute.
AI_TIMEOUT_MS=90000
