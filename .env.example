# ==================================================
# Smart Project Manager - environment template
# ==================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` (it is git-ignored).
#
# This root file is for the future Docker Compose setup (planned).
# To run a service locally, use that service's own template instead:
#   backend/.env.example  ->  backend/.env
# See docs/deployment.md.

# ---------- Backend (Node.js + Express.js) ----------
NODE_ENV=development
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:4200

# ---------- Database (MongoDB) ----------
MONGODB_URI=mongodb://localhost:27017/smart_project_manager

# ---------- Authentication (JWT) ----------
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# ---------- Initial administrator (npm run create-admin) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator

# ---------- AI service (Python + FastAPI) ----------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
